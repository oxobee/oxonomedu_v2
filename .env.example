# ==============================================================================
# LearnHouze v2.0 — Çevre Değişkenleri Şablonu (.env.example)
# ==============================================================================

# Sunucu & Alan Adı Yapılandırması
SERVER_DOMAIN=localhost:3010
COOKIE_DOMAIN=.localhost

# Veritabanı (PostgreSQL)
POSTGRES_USER=learnhouse
POSTGRES_PASSWORD=learnhouse
POSTGRES_DB=learnhouse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Pano OS Realtime State Storage (MongoDB Atlas)
# VERCEL İÇİN ZORUNLU:
# 1. Vercel Dashboard -> Project Settings -> Environment Variables altına ekleyin (Hem Production hem Preview seçin).
# 2. MongoDB Atlas -> Network Access -> IP Access List -> 0.0.0.0/0 (Tüm IP'lere İzin Ver) ekleyin (Vercel serverless IP'leri dinamiktir).
# 3. Ortam değişkenini ekledikten sonra Vercel'de mutlaka "Redeploy" tetikleyin.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/eduboard?retryWrites=true&w=majority

# Yönetici Giriş Bilgileri
ADMIN_EMAIL=admin@oxonom.com
ADMIN_PASSWORD=Ugur2803*

# Güvenlik Anahtarları (İlk kurulumda otomatik üretilir veya buraya yazılır)
